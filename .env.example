# Copiar a .env y ajustar valores locales. NUNCA subir .env al repositorio.

# PostgreSQL
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=smart_bakery;Username=postgres;Password=postgres

# Auth
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=change-me
MODEL_STORAGE_PATH=./ml-service/models
